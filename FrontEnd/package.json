{
  "name": "nexus-frontend",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@8.9.0",
  "workspaces": [
    "src/apps/**",
    "src/core",
    "src/modules/**"
  ],
  "scripts": {
    "dev:test": "pnpm --filter test run dev",
    "build:test": "pnpm --filter test run build",
    "preview:test": "pnpm --filter test run preview",
 
    "dev:trader.auth-server": "pnpm --filter trader-auth-server run dev",

     "dev:trader.shotgun": "pnpm --filter trader-shotgun run dev",
    "build:trader.shotgun": "pnpm --filter trader-shotgun run build",
    "preview:trader.shotgun": "pnpm --filter trader-shotgun run preview",

    "dev:mahar.admin": "pnpm --filter mahar-adminpanel run dev",
    "build:mahar.admin": "pnpm --filter mahar-adminpanel run build",
    "preview:mahar.admin": "pnpm --filter mahar-website run preview",

    "dev:mahar.website": "pnpm --filter mahar-website run dev",
    "build:mahar.website": "pnpm --filter mahar-website run build",
    "preview:mahar.website": "pnpm --filter mahar-website run preview",

    "dev:akwp.admin": "pnpm --filter akwp-adminpanel run dev",
    "build:akwp.admin": "pnpm --filter akwp-adminpanel run build",
    "preview:akwp.admin": "pnpm --filter akwp-adminpanel run preview",

    "dev:akwp.website": "pnpm --filter akwp-website run dev",
    "build:akwp.website": "pnpm --filter akwp-website run build",
    "preview:akwp.website": "pnpm --filter akwp-website run preview",

    "dev:trader.server": "pnpm --filter trader-server run dev",
    "build:trader.server": "pnpm --filter trader-server run build",
    "preview:trader.server": "pnpm --filter trader-server run preview",

    "dev:aksteel.website.phonebook": "pnpm --filter aksteel-website-phonebook run dev",
    "build:aksteel.website.phonebook": "pnpm --filter aksteel-website-phonebook run build",
    "preview:aksteel.website.phonebook": "pnpm --filter aksteel-website-phonebook run preview",

    "dev:aksteel.admin": "pnpm --filter aksteel-admin run dev",
    "build:aksteel.admin": "pnpm --filter aksteel-admin run build",
    "preview:aksteel.admin": "pnpm --filter aksteel-admin run preview",
    "cap:add:aksteel.admin": "cd src/apps/AKSteel/Admin && npx cap add android",
    "cap:sync:aksteel.admin": "cd src/apps/AKSteel/Admin && npx cap sync android",
    "cap:open:aksteel.admin": "cd src/apps/AKSteel/Admin && npx cap open android",
    "apk:aksteel.admin": "pnpm run build:aksteel.admin && pnpm run cap:sync:aksteel.admin && cd src/apps/AKSteel/Admin/android && gradlew assembleDebug",
    "icon:aksteel.admin": "cd src/apps/AKSteel/Admin && npx @capacitor/assets generate --android"

  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@tailwindcss/vite": "^4.1.13",
    "@tanstack/react-query": "^5.90.2",
    "axios": "^1.12.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.2",
    "tailwindcss": "^4.1.13",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7"
  }
}