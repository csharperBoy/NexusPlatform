{
  "Application": {
    "Name": "Trader Application"
  },
  "ConnectionStrings": {
    //"DefaultConnection": "Server=.;Database=TestOfPlatformDb;UserId=sa;Password=Fajr@123;TrustServerCertificate=True;MultipleActiveResultSets=true;",
    "DefaultConnection": "Server=.;Database=TestOfPlatformDb;User Id=sa;Password=Fajr@123;TrustServerCertificate=True;MultipleActiveResultSets=true;",
    "Redis": "localhost:6379,abortConnect=false,connectTimeout=30000,ssl=false"
  },
  "Modules": {
    "Enabled": [
      {
        "Name": "Core",
        "Order": 11
      },

      {
        "Name": "Event",
        "Order": 15
      },
      {
        "Name": "StreamBus",
        "Order": 18
      },

      {
        "Name": "Identity",
        "Order": 22
      },
      {
        "Name": "Base",
        "Order": 23
      },
      {
        "Name": "Audit",
        "Order": 24
      },
      {
        "Name": "Navigation",
        "Order": 25
      },
      {
        "Name": "Authorization",
        "Order": 34
      },
      {
        "Name": "Cach",
        "Order": 60
      },
      {
        "Name": "Scheduler",
        "Order": 80
      },

      {
        "Name": "Trader",
        "Order": 90
      }
    ]
  },

  "Resilience": {
    "Policies": {
      "DefaultRetry": {
        "Type": "Retry",
        "Retries": 3,
        "BaseDelaySeconds": 2,
        "Jitter": true
      },
      "DbRetry": {
        "Type": "Retry",
        "Retries": 5,
        "BaseDelaySeconds": 1,
        "Handle": "SqlException",
        "Jitter": true
      },
      "SmtpBreaker": {
        "Type": "CircuitBreaker",
        "Failures": 5,
        "BreakDurationSeconds": 60
      },
      "ExternalTimeout": {
        "Type": "Timeout",
        "TimeoutSeconds": 10
      }
    }
  },

  "CacheSettings": {
    "UseRedis": true,
    "DefaultExpirationMinutes": 30,
    "RedisInstanceName": "Trader_"
  },
  "Jwt": {
    "Key": "YourVerySecureKeyHere_ChangeThis_Minimum32CharactersLong!",
    "Issuer": "Trader",
    "Audience": "Trader",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:5173",
      "https://localhost:5174",
      "https://localhost:5175",
      "https://localhost:5176",
      "https://localhost:5177",
      "https://localhost:5178",
      "https://localhost:5179",
      "http://localhost:3000",
      "http://localhost:3001",
      "https://localhost:3000",
      "https://localhost:3001"
    ]
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {SourceContext}{NewLine}{Message:lj}{NewLine}{Exception}{NewLine}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {CorrelationId} {SourceContext}{NewLine}{Message:lj}{NewLine}{Exception}{NewLine}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "HealthCheck": {
    "Enabled": true,
    "Endpoint": "/health",
    "TimeoutSeconds": 10
  },
  "Scheduler": {
    "DefaultQueue": "scheduler",
    "DefaultPreFireBuffer": "00:00:15",
    "SchedulePollIntervalSeconds": 5,
    "WorkerCount": 50
  },
  "Brokers": {
    "EasyTrader": {
      "BaseUrl": "https://api-mts.orbis.easytrader.ir",
      "OidcBaseUrl": "https://login.emofid.com",
      "ClientId": "easy_pkce",
      "RedirectUri": "https://d.easytrader.ir/auth-callback",
      "Scope": "easy2_api mts_api openid profile login_delegation-api",
      "TimeoutSeconds": 30,
      "AppBuildNo": "53559"
    }
  }


}
