{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Debug" // فعال سازی لاگ‌های YARP
    }
  },
  "ReverseProxy": {
    "Routes": {
      "backend": {
        "ClusterId": "backend-cluster",
        "Match": {
          "Path": "/{**catchAll}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/" } // اختیاری برای حذف پیشوند
        ]
      }
    },
    "Clusters": {
      "backend-cluster": {
        "Destinations": {
          "backend": {
            "Address": "http://aksteel-webapi:8080/"
          }
        }
      }
    }
  }
}

